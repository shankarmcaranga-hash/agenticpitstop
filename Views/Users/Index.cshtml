@{
    ViewBag.Title = "User Management";
    var users = (DataTable)ViewBag.Users;
    var history = (DataTable)ViewBag.History;
    var roles = (DataTable)ViewBag.Roles ?? new DataTable();
    var useCases = (DataTable)ViewBag.UseCases ?? new DataTable();
    var canAssignAdmin = ViewBag.CurrentAccessType == ApsIdentity.RoleAdmin;

    ViewData["PageTitle"] = "User Management";
    ViewData["PageSubtitle"] = "Manage portal users, role assignment, active status, soft deletion, and audit history.";
    ViewData["PageBreadcrumb"] = "Administration / User Management";
    ViewData["PageActions"] = "<button class=\"btn btn-primary\" id=\"addUserButton\">" +
                          "<i class=\"fa-solid fa-user-plus\"></i>Add user</button>";
}

@await Html.PartialAsync("_PageHeader")

<div class="grid layout-2-1">
    <div class="card">
        <div class="card-body">
            <form class="toolbar" method="get" asp-action="Index">
                <div class="toolbar-left">
                    <input type="search" name="search" value="@ViewBag.Search"
                           placeholder="Search users..." aria-label="Search users" />
                    <select name="status" id="statusFilter" aria-label="Filter by status">
                        @foreach (var option in new[] { "All statuses", "Active", "Inactive" })
                        {
                            <option value="@option" selected="@(((string)ViewBag.Status) == option)">@option</option>
                        }
                    </select>
                    <button class="btn btn-sm" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
                </div>
                <div class="toolbar-right">
                    <span class="badge badge-neutral">@users.Rows.Count users</span>
                </div>
            </form>

            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Portal ID</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Last action</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (users.Rows.Count == 0)
                        {
                            <tr><td colspan="6">No users match this search. Clear the filters or add a user.</td></tr>
                        }
                        else
                        {
                            foreach (DataRow user in users.Rows)
                            {
                                var active = Convert.ToByte(user["activestatus"]) == 1;
                                <tr>
                                    <td><strong>@user["portalid"]</strong></td>
                                    <td>
                                        <strong>@user["firstname"] @user["lastname"]</strong><br />
                                        <span class="input-help">@user["emailid"]</span>
                                    </td>
                                    <td><span class="badge badge-info">@user["accesstypename"]</span></td>
                                    <td>
                                        <span class="badge @(active ? "badge-success" : "badge-danger")">
                                            @(active ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        @user["actiontype"]<br />
                                        <span class="input-help">
                                            @Convert.ToDateTime(user["actiondt"]).ToString("dd MMM yyyy · HH:mm") ·
                                            @user["actionby"]
                                        </span>
                                    </td>
                                    <td>
                                        @* Icons rather than labels: the row is read at a glance and
                                           three words of button were competing with the user's name.
                                           title and aria-label carry the meaning for the tooltip and
                                           for a screen reader. *@
                                        <div class="actions-cell">
                                            <button class="btn btn-sm btn-ico" data-action="edit-user"
                                                    data-uid="@user["uid"]"
                                                    title="Edit user" aria-label="Edit user">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button class="btn btn-sm btn-ico" data-action="toggle-user"
                                                    data-uid="@user["uid"]"
                                                    data-name="@user["firstname"] @user["lastname"]"
                                                    data-active="@(active ? "1" : "0")"
                                                    title="@(active ? "Inactivate user" : "Activate user")"
                                                    aria-label="@(active ? "Inactivate user" : "Activate user")">
                                                <i class="fa-solid @(active ? "fa-user-slash" : "fa-user-check")"></i>
                                            </button>
                                            <button class="btn btn-sm btn-ico" data-action="delete-user"
                                                    data-uid="@user["uid"]"
                                                    data-name="@user["firstname"] @user["lastname"]"
                                                    title="Delete user" aria-label="Delete user">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-title-row">
                <div>
                    <h2 class="card-title">Action history</h2>
                    <p class="card-subtitle">Recent user administration changes.</p>
                </div>
                <span class="badge badge-neutral">Audit</span>
            </div>
        </div>
        <div class="card-body">
            <ul class="timeline">
                @foreach (DataRow entry in history.Rows)
                {
                    <li>
                        <strong>@entry["firstname"] @entry["lastname"] · @entry["actiontype"]</strong>
                        <span>
                            @ApsIdentity.RoleNameFor(Convert.ToInt32(entry["accesstype"])) ·
                            @entry["actionby"] ·
                            @Convert.ToDateTime(entry["actiondt"]).ToString("dd MMM yyyy · HH:mm")
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.ApsNonce()">
                (function ($) {
                'use strict';
                var canAssignAdmin = @(canAssignAdmin ? "true" : "false");

                // Changing the status filters straight away.
                $('#statusFilter').on('change', function () { this.form.submit(); });

                           // Active roles exactly as APS_RoleMaster holds them.
                            var ROLES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                            roles.AsEnumerable().Select(r => new
                                            {
                                                        id = Convert.ToInt32(r["RoleID"]),
                                                        name = Convert.ToString(r["RoleName"])
                                            })));

                            // Active use cases only - a deactivated one cannot be granted. The
                            // ticks themselves come from Masters/MappingFor when editing.
                            var USECASES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                                                                    useCases.AsEnumerable()
                                                                            .Where(r => Convert.ToInt32(r["IsActive"]) == 1)
                                                                            .Select(r => new
                                                                            {
                                                                                    useCaseId = Convert.ToInt32(r["UseCaseID"]),
                                                                                    useCaseCode = ApsMetadata.Cell(r, "UseCaseCode"),
                                                                                    useCaseName = ApsMetadata.Cell(r, "UseCaseName"),
                                                                                    clientName = ApsMetadata.Cell(r, "ClientName"),
                                                                                    processName = ApsMetadata.Cell(r, "ProcessName")
                                                                            })));

        var mappingUrl = '@Url.Action("MappingFor", "Masters")';

            // Active use cases only - a deactivated one cannot be granted. The
            // ticks themselves come from Masters/MappingFor when editing.
            var USECASES = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            useCases.AsEnumerable()
                                .Where(r => Convert.ToInt32(r["IsActive"]) == 1)
                                .Select(r => new
                                {
                                    useCaseId   = Convert.ToInt32(r["UseCaseID"]),
                                    useCaseCode = ApsMetadata.Cell(r, "UseCaseCode"),
                                    useCaseName = ApsMetadata.Cell(r, "UseCaseName"),
                                    clientName  = ApsMetadata.Cell(r, "ClientName"),
                                    processName = ApsMetadata.Cell(r, "ProcessName")
                                })));

            var mappingUrl = '@Url.Action("MappingFor", "Masters")';

            function roleOptions(selected) {
            return ROLES.filter(function (role) {
                    // A Manager must not be able to mint another Admin.
                    return canAssignAdmin || role.id !== @ApsIdentity.RoleAdmin;
                })
                .map(function (role) {
                    return '<option value="' + role.id + '"' +
                           (Number(selected) === role.id ? ' selected' : '') + '>' +
                           APS.escapeHtml(role.name) + '</option>';
                }).join('');
        }

                        // Grouped by client, because that is how an administrator thinks about
            // them, and it matches the Use Case Mapping screen this replaces.
            function useCaseListHtml() {
                if (!USECASES.length) {
                    return '<p class="um-uc-empty">' +
                           'No active use cases exist yet. Create one on the Use Case Master screen.' +
                           '</p>';
                }

                var groups = {}, order = [];

                USECASES.forEach(function (row) {
                    var client = row.clientName || 'Unassigned';
                    if (!groups[client]) { groups[client] = []; order.push(client); }
                    groups[client].push(row);
                });

                return order.map(function (client) {
                    return '<div class="dl-qgroup">' +
                             '<div class="dl-qgroup-title">' + APS.escapeHtml(client) + '</div>' +
                             groups[client].map(function (row) {
                                 return '<label class="dl-check">' +
                                          '<input type="checkbox" class="map-usecase" value="' + row.useCaseId + '" />' +
                                          '<span>' + APS.escapeHtml(row.useCaseName) +
                                            '<small>' + APS.escapeHtml(row.useCaseCode) +
                                            (row.processName ? ' &middot; ' + APS.escapeHtml(row.processName) : '') +
                                            '</small>' +
                                          '</span>' +
                                        '</label>';
                             }).join('') +
                           '</div>';
                }).join('');
            }

            function userForm(user) {
                user = user || {};
                return '' +
                  '<div class="form-grid">' +
                     '<div class="form-group"><label>Portal ID</label>' +
                      '<input id="fPortalId" value="' + APS.escapeAttr(user.portalid || '') +
                      '" maxlength="8" inputmode="numeric" />' +
                       '<span class="input-help">Windows username without the domain. 6 or 8 digits.</span>' +
                      '<span class="field-error" data-for="fPortalId"></span></div>' +
                    '<div class="form-group"><label>Role</label>' +
                      '<select id="fAccessType">' + roleOptions(user.accesstype) + '</select></div>' +
                      '<div class="form-group"><label>First name</label>' +
                      '<input id="fFirstName" value="' + APS.escapeAttr(user.firstname || '') + '" maxlength="100" />' +
                      '<span class="input-help">Letters only.</span>' +
                      '<span class="field-error" data-for="fFirstName"></span></div>' +
                    '<div class="form-group"><label>Last name</label>' +
                      '<input id="fLastName" value="' + APS.escapeAttr(user.lastname || '') + '" maxlength="100" />' +
                      '<span class="input-help">Letters only.</span>' +
                      '<span class="field-error" data-for="fLastName"></span></div>' +
                    '<div class="form-group full"><label>Email address</label>' +
                      '<input id="fEmail" type="email" value="' + APS.escapeAttr(user.emailid || '') + '" maxlength="256" />' +
                      '<span class="field-error" data-for="fEmail"></span></div>' +

                    // What used to be the Use Case Mapping screen. Role decides which
                    // screens a user sees; this decides which use cases they see inside
                    // them, so the two belong in one dialog.
                    '<div class="form-group full um-usecases">' +
                      '<div class="um-uc-head">' +
                        '<div>' +
                          '<strong>Use case access</strong>' +
                          '<span class="input-help">Tick the use cases this user may open. ' +
                          'Unticking revokes the grant; the history is kept.</span>' +
                        '</div>' +
                        '<div class="um-uc-tools">' +
                          '<span class="badge badge-info" id="ucCount">0 selected</span>' +
                          '<button type="button" class="btn btn-sm" id="ucSelectAll">Select all</button>' +
                          '<button type="button" class="btn btn-sm" id="ucClearAll">Clear all</button>' +
                        '</div>' +
                      '</div>' +
                      '<div class="um-uc-list" id="ucList">' + useCaseListHtml() + '</div>' +
                    '</div>' +
                  '</div>';
            }
            function clearFieldErrors() { $('.field-error').text(''); }

            function showFieldError(id, message) {
                $('.field-error[data-for="' + id + '"]').text(message);
            }

            // The server decides; this repeats the same rules so the user is told
            // at once, with the form still open and their typing intact.
            function validateUserForm(payload) {
                clearFieldErrors();
                var problems = [];

                if (!/^(\d{6}|\d{8})$/.test(payload.portalid)) {
                    showFieldError('fPortalId', 'Portal ID must be 6 or 8 digits.');
                    problems.push('Portal ID must be 6 or 8 digits.');
                }
                if (!/^[A-Za-z]+$/.test(payload.firstname)) {
                    showFieldError('fFirstName', 'First name must contain letters only.');
                    problems.push('First name must contain letters only.');
                }
                if (!/^[A-Za-z]+$/.test(payload.lastname)) {
                    showFieldError('fLastName', 'Last name must contain letters only.');
                    problems.push('Last name must contain letters only.');
                }
                if (!/^[A-Za-z0-9.]+@@[A-Za-z0-9.]+\.[A-Za-z]{2,}$/.test(payload.emailid)) {
                    showFieldError('fEmail', 'Enter a valid email address.');
                    problems.push('Enter a valid email address.');
                }

                return problems;
            }
            function openUserModal(user) {
                var isEdit = !!(user && user.uid);

            APS.openModal(isEdit ? 'Edit user' : 'Add user', userForm(user),
                '<button class="btn" data-modal-close>Cancel</button>' +
                '<button class="btn btn-primary" id="saveUserButton">' +
                (isEdit ? 'Save changes' : 'Add user') + '</button>');

            // Characters are dropped as they are typed or pasted, so the field can
            // never hold a value the save would refuse. The checks on Save and in
            // SQL still decide - this only saves the user a round trip.
            $('#fFirstName, #fLastName').on('input', function () {
                var cleaned = this.value.replace(/[^A-Za-z]/g, '');
                if (cleaned !== this.value) { this.value = cleaned; }
            });

            $('#fPortalId').on('input', function () {
                var cleaned = this.value.replace(/[^0-9]/g, '').slice(0, 8);
                if (cleaned !== this.value) { this.value = cleaned; }
            });

                       $('#fEmail').on('input', function () {
                var cleaned = this.value.replace(/[^A-Za-z0-9.@@]/g, '');
                if (cleaned !== this.value) { this.value = cleaned; }
            });

            // ---- use case access ------------------------------------------------
            function ucCount() {
                $('#ucCount').text($('#ucList .map-usecase:checked').length + ' selected');
            }

            $('#ucSelectAll').on('click', function () {
                $('#ucList .map-usecase').prop('checked', true);
                ucCount();
            });

            $('#ucClearAll').on('click', function () {
                $('#ucList .map-usecase').prop('checked', false);
                ucCount();
            });

            $('#ucList').on('change', '.map-usecase', ucCount);

            // The list is already on screen; only the ticks are fetched, so the
            // dialog never shows a blank panel while the request is in flight.
            if (isEdit) {
                $.getJSON(mappingUrl, { userId: user.uid }, function (response) {
                    if (!response.success) { return; }
                    (response.data || []).forEach(function (row) {
                        if (row.isMapped) {
                            $('#ucList .map-usecase[value="' + row.useCaseId + '"]').prop('checked', true);
                        }
                    });
                    ucCount();
                });
            } else {
                ucCount();
            }

            $('#saveUserButton').on('click', function () {
                    var payload = {
                        uid: isEdit ? user.uid : 0,
                        portalid: $('#fPortalId').val().trim(),
                        firstname: $('#fFirstName').val().trim(),
                        lastname: $('#fLastName').val().trim(),
                        emailid: $('#fEmail').val().trim(),
                        accesstype: $('#fAccessType').val(),
                        useCaseIds: $('#ucList .map-usecase:checked')
                                        .map(function () { return this.value; })
                                        .get().join(',')
                    };

                        var problems = validateUserForm(payload);
                        if (problems.length) {
                            APS.toast(problems[0], 'error');
                            return;
                        }

                        APS.busy(this, APS.post('@Url.Action("Save", "Users")', payload))
                       .then(function (response) {
                           if (!response.success) { return; }
                           APS.closeModal();
                           APS.toast(response.message, 'success');
                           window.location.reload();
                       });
                });
            }

            $('#addUserButton').on('click', function () { openUserModal(null); });

            $(document).on('click', '[data-action="edit-user"]', function () {
                var uid = $(this).data('uid');
                $.getJSON('@Url.Action("Get", "Users")', { id: uid }, function (response) {
                    if (response.success) { openUserModal(response.data); }
                    else { APS.toast(response.message, 'error'); }
                });
            });

               $(document).on('click', '[data-action="toggle-user"]', function () {
                    var uid = $(this).data('uid');
                    var name = $(this).data('name');
                    var isActive = String($(this).data('active')) === '1';

                            var title = isActive ? 'Deactivate user' : 'Activate user';
                    var message = isActive
                    ? 'Deactivating ' + name + ' will immediately prevent sign-in access and create a \'Deactivated\' audit record. The account and its data will be retained. Do you want to continue?'
                    : 'Activating ' + name + ' will restore sign-in access and create an \'Activated\' audit record. Do you want to continue?';
                    APS.confirmAction(title, message, title, function () {
                        APS.post('@Url.Action("ToggleStatus", "Users")', { uid: uid })
                           .then(function (response) {
                               if (response.success) {
                                   APS.toast(response.message, 'success');
                                   window.location.reload();
                               }
                           });
                    });
                });

            $(document).on('click', '[data-action="delete-user"]', function () {
                var uid = $(this).data('uid');
                var name = $(this).data('name');

                APS.confirmAction('Delete user',
                    'Are you sure you want to delete ' + name + '? The account will be marked as inactive, and a deletion audit record will be created.',
                    'Delete user',
                    function () {
                        APS.post('@Url.Action("Delete", "Users")', { uid: uid })
                           .then(function (response) {
                               if (response.success) {
                                   APS.toast(response.message, 'success');
                                   window.location.reload();
                               }
                           });
                    });
            });
        })(jQuery);
    </script>
}
