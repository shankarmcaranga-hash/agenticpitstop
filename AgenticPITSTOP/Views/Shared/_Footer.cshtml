@* Footer area styled to match the pit-stop image footer with banner and step sequence *@
<footer class="site-footer py-3">
    <div class="container-fluid">
        <div class="footer-inner d-flex align-items-center justify-content-between">
            <div class="footer-banner d-none d-md-block">
                <img src="~/images/pitstop-left.svg" alt="Pit Stop" onerror="this.style.display='none'" />
            </div>

            <div class="footer-steps flex-fill text-center">
                <div class="steps-row d-flex justify-content-center align-items-center">
                    <div class="footer-step">
                        <div class="step-icon bg-white shadow-sm">
                            <svg width="20" height="20" aria-hidden="true"><use href="#icon-car"></use></svg>
                        </div>
                        <div class="step-label">INTAKE<br/><small>Collect &amp; Receive</small></div>
                    </div>

                    <div class="footer-arrow" aria-hidden="true"><svg width="16" height="16"><use href="#icon-arrow-right"></use></svg></div>

                    <div class="footer-step">
                        <div class="step-icon bg-white shadow-sm">
                            <svg width="20" height="20" aria-hidden="true"><use href="#icon-upload"></use></svg>
                        </div>
                        <div class="step-label">AI PROCESSING<br/><small>Extract &amp; Validate</small></div>
                    </div>

                    <div class="footer-arrow" aria-hidden="true"><svg width="16" height="16"><use href="#icon-arrow-right"></use></svg></div>

                    <div class="footer-step">
                        <div class="step-icon bg-white shadow-sm">
                            <svg width="20" height="20" aria-hidden="true"><use href="#icon-user"></use></svg>
                        </div>
                        <div class="step-label">HUMAN REVIEW<br/><small>Review &amp; Decide</small></div>
                    </div>

                    <div class="footer-arrow" aria-hidden="true"><svg width="16" height="16"><use href="#icon-arrow-right"></use></svg></div>

                    <div class="footer-step">
                        <div class="step-icon bg-white shadow-sm">
                            <svg width="20" height="20" aria-hidden="true"><use href="#icon-settings"></use></svg>
                        </div>
                        <div class="step-label">RELEASE<br/><small>Post &amp; Publish</small></div>
                    </div>

                    <div class="footer-arrow" aria-hidden="true"><svg width="16" height="16"><use href="#icon-arrow-right"></use></svg></div>

                    <div class="footer-step">
                        <div class="step-icon bg-white shadow-sm">
                            <svg width="20" height="20" aria-hidden="true"><use href="#icon-trophy"></use></svg>
                        </div>
                        <div class="step-label">COMPLETE<br/><small>Closed Successfully</small></div>
                    </div>
                </div>
            </div>

            <div class="footer-meta d-none d-md-flex flex-column text-end small text-muted">
                <div>&copy; 2026 AgenticPITSTOP</div>
                <div><a href="#" class="text-muted">Privacy</a> &middot; <a href="#" class="text-muted">Terms</a></div>
            </div>
        </div>
    </div>
</footer>
